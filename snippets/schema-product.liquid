{%- liquid
  assign product_url = request.origin | append: product.url
  assign product_image_url = ''
  if product.featured_image
    assign product_image_url = product.featured_image | image_url: width: 1200
  endif
  assign has_rating = false
  if product.metafields.reviews.rating.value != blank
    assign has_rating = true
    assign rating_value = product.metafields.reviews.rating.value.rating
    assign rating_max = product.metafields.reviews.rating.value.scale_max
    assign rating_count = product.metafields.reviews.rating_count
  endif
  assign product_description = product.description | strip_html | strip | truncate: 500
  if product_description == blank
    assign product_description = product.title | append: ' — House of Steam'
  endif
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {{ product_description | json }},
  "url": "{{ product_url }}",
  {%- if product_image_url != '' -%}
  "image": "https:{{ product_image_url }}",
  {%- endif -%}
  "brand": {
    "@type": "Brand",
    "name": "House of Steam"
  },
  "sku": {{ product.selected_or_first_available_variant.sku | strip | default: product.id | json }},
  "offers": [
    {%- for variant in product.variants -%}
    {%- assign variant_sku = variant.sku | strip -%}
    {
      "@type": "Offer",
      "name": {{ variant.title | json }},
      "sku": {{ variant_sku | default: variant.id | json }},
      {%- if variant.barcode != blank -%}
      "gtin": {{ variant.barcode | strip | json }},
      {%- else -%}
      "mpn": {{ variant_sku | default: variant.id | json }},
      {%- endif -%}
      "price": "{{ variant.price | money_without_currency | strip_html }}",
      "priceCurrency": "{{ cart.currency.iso_code }}",
      "availability": "{% if variant.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
      "url": "{{ product_url }}?variant={{ variant.id }}",
      "seller": {
        "@type": "Organization",
        "name": "House of Steam"
      },
      "hasMerchantReturnPolicy": {
        "@type": "MerchantReturnPolicy",
        "applicableCountry": "DE",
        "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
        "merchantReturnDays": 14,
        "returnMethod": "https://schema.org/ReturnByMail",
        "returnFees": "https://schema.org/FreeReturn"
      },
      "shippingDetails": {
        "@type": "OfferShippingDetails",
        "shippingRate": {
          "@type": "MonetaryAmount",
          "value": "0",
          "currency": "{{ cart.currency.iso_code }}"
        },
        "shippingDestination": {
          "@type": "DefinedRegion",
          "addressCountry": "DE"
        },
        "deliveryTime": {
          "@type": "ShippingDeliveryTime",
          "handlingTime": {
            "@type": "QuantitativeValue",
            "minValue": 1,
            "maxValue": 2,
            "unitCode": "DAY"
          },
          "transitTime": {
            "@type": "QuantitativeValue",
            "minValue": 2,
            "maxValue": 4,
            "unitCode": "DAY"
          }
        }
      }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
  {%- if has_rating -%}
  ,"aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "{{ rating_value }}",
    "bestRating": "{{ rating_max }}",
    "ratingCount": "{{ rating_count }}"
  }
  {%- endif -%}
}
</script>
